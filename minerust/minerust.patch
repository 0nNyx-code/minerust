diff --git a/crates/horizon-client-render/src/shader_pack_list.rs b/crates/horizon-client-render/src/shader_pack_list.rs
index 3e88014..f0efa52 100644
--- a/crates/horizon-client-render/src/shader_pack_list.rs
+++ b/crates/horizon-client-render/src/shader_pack_list.rs
@@ -8,6 +8,24 @@ use horizon_shader_api::{OptionKind, OptionPage, PackOption};
 
 pub const DIR: &str = "shaderpacks";
 
+/// The pack this fork ships and picks on a fresh install: LIGHT's look tuned for
+/// mobile GPUs (smaller shadow map, RGBA8 gbuffer, no TAA, fewer samples).
+pub const BUNDLED_FILE: &str = "LIGHT-HorizonFix-Lite.zip";
+const BUNDLED_BYTES: &[u8] = include_bytes!("../shaderpacks/LIGHT-HorizonFix-Lite.zip");
+
+/// Put the bundled pack in `dir` when it is not there yet, so the pack named by
+/// `Settings` default is always readable. Best effort: a read-only folder only
+/// loses the default, never the launcher.
+pub fn ensure_bundled(dir: &Path) {
+    let path = dir.join(BUNDLED_FILE);
+    if std::fs::metadata(&path).is_ok_and(|m| m.len() == BUNDLED_BYTES.len() as u64) {
+        return;
+    }
+    if std::fs::create_dir_all(dir).is_ok() {
+        let _ = std::fs::write(&path, BUNDLED_BYTES);
+    }
+}
